// tgvoiptest.exe: full-duplex echo test via VoIP Audio Services (see voiptest.cpp)
TARGET        tgvoiptest.exe
TARGETTYPE    exe
UID           0x0 0xE7A3D5E1
CAPABILITY    MultimediaDD ReadDeviceData WriteDeviceData UserEnvironment
VENDORID      0
EPOCSTACKSIZE 0x5000

SYSTEMINCLUDE \epoc32\include
USERINCLUDE   ..

SOURCEPATH    ..
SOURCE        voiptest.cpp

LIBRARY       euser.lib efsrv.lib voipaudiointfc.lib
